{
  "expo": {
    "name": "Aurora Walls",
    "slug": "aurora-walls",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "aurora",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "aurora-sa",
          "project": "react-native"
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shubhzx09.aurorawalls"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.shubhzx09.aurorawalls",
      "launchMode": "singleTask",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "www.aurora-walls.com", "pathPrefix": "/wallpaper/" },
            { "scheme": "https", "host": "www.aurora-walls.com", "pathPrefix": "/category/" },
            { "scheme": "https", "host": "www.aurora-walls.com", "pathPrefix": "/collection/" },
            { "scheme": "https", "host": "www.aurora-walls.com", "path": "/trending" },
            { "scheme": "https", "host": "www.aurora-walls.com", "path": "/latest" },
            { "scheme": "https", "host": "www.aurora-walls.com", "path": "/categories" },
            { "scheme": "https", "host": "www.aurora-walls.com", "path": "/search" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#111111",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b42fe208-71d2-4443-8c22-8a6ddc63da11"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b42fe208-71d2-4443-8c22-8a6ddc63da11"
    }
  }
}
